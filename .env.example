# Copia este archivo como .env y rellena los valores reales
# El archivo .env NO debe subirse a git

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://<HOST>:5432/<DB_NAME>?currentSchema=sia
DB_USERNAME=<USUARIO>
DB_PASSWORD=<CONTRASEÑA>

# JWT
# Generar con: openssl rand -base64 32
JWT_SECRET=<SECRET_BASE64>
JWT_EXPIRATION=86400000


SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change_me_super_admin
SUPER_ADMIN_NOMBRES=Super
SUPER_ADMIN_APELLIDOS=Admin

S3_BUCKET=sia-archivos
AWS_REGION=us-east-1
# Tiempo de expiración de URLs pre-firmadas de S3 (en minutos, default: 60)
S3_PRESIGNED_URL_EXPIRATION_MINUTES=60

# CORS: orígenes permitidos separados por coma (default incluye localhost:4200 y CloudFront)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
# Solo desarrollo local: permite previews Angular con puertos dinamicos.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# FastAPI IA — backend de inteligencia artificial
FASTAPI_BASE_URL=http://localhost:8001

# Firebase FCM — ruta al archivo de credenciales de service account (NO subir a git)
# Descargar desde: Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_CREDENTIALS_PATH=gestion-academica-firebase.json

# SMTP — envío de correos (TurboSMTP o cualquier proveedor compatible)
MAIL_TRANSPORT=SMTP
SMTP_HOST=pro.turbo-smtp.com
SMTP_PORT=587
SMTP_USERNAME=<USUARIO_TURBOSMTP>
SMTP_PASSWORD=<CONTRASEÑA_TURBOSMTP>
# Debe ser un remitente con dominio existente y autorizado por tu proveedor SMTP
# Ejemplo: no-reply@tu-dominio.com o tu correo verificado
SMTP_FROM=no-reply@example.com
MAIL_FROM_NAME=SIA

# ------------------------------------------------------------------------------
# Alternativa para DESARROLLO: Mailtrap SMTP (Sandbox)
# ------------------------------------------------------------------------------
# Usa esta configuración en tu .env local para pruebas rápidas sin validar SPF/DKIM:
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=<MAILTRAP_SMTP_USERNAME>
# SMTP_PASSWORD=<MAILTRAP_SMTP_PASSWORD>
# SMTP_FROM=hello@demomailtrap.co
#
# Nota: El backend actual envía por SMTP (JavaMailSender).
# No necesitas integrar el SDK/API de Mailtrap para que funcione el endpoint /api/saas/email/prueba.

# ------------------------------------------------------------------------------
# Alternativa para usar API de Mailtrap (si SMTP no está habilitado en tu cuenta)
# ------------------------------------------------------------------------------
# MAIL_TRANSPORT=MAILTRAP_API
# MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
# MAILTRAP_API_TOKEN=<TOKEN_API_MAILTRAP>

# Vpay — pasarela de pago (pago de onboarding del plan)
# Dejar VPAY_TOKEN vacío para operar en modo DEMO (QR de demostración, estado siempre PEN)
VPAY_BASE_URL=https://vpay.com.bo:7778/pro
VPAY_TOKEN=
VPAY_USER=
VPAY_COMPANY=1
VPAY_BANK=BMSC
VPAY_DESTINATION_ACCOUNT=
VPAY_VERIFY_SSL=true

# URL pública del frontend (usada para generar links en correos)
FRONTEND_URL=http://localhost:4200

# Analisis nocturno de riesgo academico (cron Spring de seis campos)
RIESGO_ACADEMICO_SCHEDULER_ENABLED=true
RIESGO_ACADEMICO_SCHEDULER_CRON=0 0 2 * * *
